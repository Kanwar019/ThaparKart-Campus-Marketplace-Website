# Backend Server Port
PORT=5000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thaparkart?retryWrites=true&w=majority

# JWT Signing Secret (must be a strong, unique secret; default placeholder will fail closed)
JWT_SECRET=your_super_secret_jwt_key_here

# SMTP / Email Configuration for OTPs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@thapar.edu
SMTP_PASS=your_smtp_app_password
SMTP_FROM="ThaparKart <your_email@thapar.edu>"
OTP_TTL_MINUTES=5

# CORS and Socket.IO Allowed Origins (optional, defaults to local dev/preview/render domains)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
